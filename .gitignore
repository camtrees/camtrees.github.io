# Not sure what a .gitignore is?
# See: https://git-scm.com/docs/gitignore

# These are directly copied from Jekyll's first-party docs on `.gitignore` files:
# https://jekyllrb.com/tutorials/using-jekyll-with-bundler/#commit-to-source-control

# Ignore the default location of the built site, and caches and metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler
.bundle/
vendor/

# EpiCollect access tokens are short-lived credentials, but they should still
# remain outside source control and the public GitHub Pages site.
epicollect_*_access_token
scripts/epicollect_*_access_token

# Ignore Mac folder view
**/.DS_Store

# Nightly maintenance logs can contain private EpiCollect record details. The
# workflow uploads them as temporary Actions artifacts instead of committing them.
outputs/nightly/*.log

#Ignore Python and PyCharm items
/scripts/__pycache__
/scripts/.env
/scripts/.idea

# Ignore automatically generated Python bytecode and extension files
*.py[cod]
